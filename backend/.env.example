# Desarrollo local
DATABASE_URL=sqlite:///./recetas.db
SECRET_KEY=cambia_esta_clave_larga_en_produccion
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10

# Usuario administrador inicial
ADMIN_EMAIL=admin@recetas.pe
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador del Sistema

# OCR
# google_vision recomendado para recetas manuscritas.
# easyocr solo si instalas requirements-ocr.txt.
OCR_ENGINE=google_vision

# Google Vision local: usa una de estas dos formas.
# Opción A: ruta al JSON descargado de Google Cloud
# GOOGLE_APPLICATION_CREDENTIALS=D:/recetas/google-vision-key.json
# Opción B: JSON completo como variable de entorno, recomendado para Render
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Almacenamiento de imágenes
# local para desarrollo; supabase para despliegue real.
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# Solo si STORAGE_BACKEND=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
# SUPABASE_STORAGE_BUCKET=recetas
